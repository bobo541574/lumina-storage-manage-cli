# --- Application ---
APP_NAME="Storage Manager"
APP_ENV=development
APP_VERSION=0.1.0

# --- Storage configuration ---
STORAGE_DEFAULT_DRIVER=rclone
STORAGE_RCLONE_BINARY=rclone
STORAGE_RCLONE_TIMEOUT=3600

# --- Logging ---
STORAGE_LOG_PATH=~/.config/storage-cli/logs
STORAGE_LOG_MAX_FILES=14
STORAGE_LOG_LEVEL=info
LOG_CHANNEL=storage

# --- Transfer defaults ---
STORAGE_DEFAULT_TRANSFERS=8
STORAGE_DEFAULT_RETRIES=3
STORAGE_OVERWRITE=false
STORAGE_RECURSIVE=false

# ACL for written objects when --acl is omitted. Accepts private|public or a
# canned S3 ACL. Empty = inherit the destination remote's own configured acl.
STORAGE_DEFAULT_ACL=

# --- Discovery cache (seconds; 0 disables) ---
STORAGE_CACHE_TTL=300

# --- Database ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Cache store: file (persists across runs) or array (per-process) ---
CACHE_STORE=file

# --- Queue: sync runs transfers in-process; database enables --queue / retry ---
QUEUE_CONNECTION=sync
DB_QUEUE_TABLE=jobs
QUEUE_FAILED_DRIVER=database-uuids